{
  "name": "coderemote",
  "version": "0.1.0",
  "description": "Use your computer from your iPhone: files, git and a real terminal over a secure Microsoft Dev Tunnel. No SSH, no port forwarding, no VPN.",
  "keywords": [
    "remote",
    "remote-terminal",
    "remote-development",
    "terminal",
    "ios",
    "iphone",
    "mobile",
    "dev-tunnels",
    "devtunnel",
    "tunnel",
    "ssh-alternative",
    "file-explorer",
    "git",
    "pty",
    "cli",
    "vscode",
    "code-remote"
  ],
  "homepage": "https://github.com/CodeRemoteApp/coderemote#readme",
  "bugs": {
    "url": "https://github.com/CodeRemoteApp/coderemote/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeRemoteApp/coderemote.git",
    "directory": "apps/agent"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Thanh Tran",
  "type": "module",
  "bin": {
    "coderemote": "dist/coderemote.js"
  },
  "files": [
    "dist",
    "scripts/fix-node-pty.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js",
    "prepack": "node scripts/build.js && cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vsremote/agent-core": "*",
    "@vsremote/protocol": "*",
    "esbuild": "^0.25.11"
  }
}
