{
  "description": "Code Remote: forwards Codex session events to the coderemote agent sharing this folder",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 660
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook\"",
            "commandWindows": "node -e \"import(require('url').pathToFileURL(process.env.PLUGIN_ROOT+'/hooks/run-hook.mjs'))\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
